{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EtkinlikCepte",
  "version": "0.1.0",
  "identifier": "com.etkinlikcepte.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "EtkinlikCepte",
        "width": 420,
        "height": 840,
        "resizable": true
      }
    ],
    "security": {
      "capabilities": ["default"],
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
