# Kopyala, doldur, asla commit'leme: `cp .env.example .env`
# (.env ve .env.* ignore'lu; .env.example izlenir.)
POSTGRES_USER=projectx
POSTGRES_PASSWORD=change-me
POSTGRES_DB=projectx
SITE_ADDRESS=localhost
LIVEKIT_KEY=devkey
# Dev'de infra/livekit/livekit.yaml `keys` ile aynı olmalı (devkey: secret).
LIVEKIT_SECRET=secret
# Telefonla deneme (R9): LIVEKIT_BIND=0.0.0.0 ve LIVEKIT_NODE_IP=<PC LAN IP'si>
LIVEKIT_BIND=127.0.0.1
LIVEKIT_NODE_IP=127.0.0.1
